# ─── AksharSetu Environment Variables ────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# Sarvam AI TTS API Key (get yours at https://sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Google Generative AI (Gemini) API Key — used for RAG / Tutor Q&A
GOOGLE_GENERATIVE_AI_KEY=your_gemini_api_key_here

# (Optional) Backend host/port overrides
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
